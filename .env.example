# ============================================================
# Nothing App — Environment Variables
# Copy to .env.local and fill in real values.
#
# REQUIRED vs OPTIONAL
#   [REQUIRED] — app will not start or will fail at runtime without this
#   [OPTIONAL] — has a default or graceful fallback
#
# SERVER-ONLY vs PUBLIC
#   Variables prefixed NEXT_PUBLIC_ are bundled into the client JS.
#   Everything else is server-only. Never put secrets in NEXT_PUBLIC_ vars.
#
# MOST SENSITIVE: BSV_FUNDING_KEY
#   This is the WIF private key for the wallet that funds every on-chain tx.
#   - Never log it, never expose it in client bundles, never commit it.
#   - Rotate it by sweeping funds to a new key and updating this value.
#   - In Vercel, set it as a Production-only encrypted environment variable.
# ============================================================


# ------------------------------------------------------------------
# DATABASE [REQUIRED] — server-only
#
# Supabase Postgres via the Transaction Pooler (PgBouncer).
# Port 6543 is the Transaction Pooler. Port 5432 is the direct connection.
#
# IMPORTANT — use port 6543 (Transaction Pooler) for serverless/Vercel:
#   - Serverless functions open a new DB connection on every invocation.
#   - PgBouncer multiplexes those into a small number of real connections.
#   - The Session Pooler (port 5432) does NOT work with FOR UPDATE SKIP LOCKED,
#     which the UTXO checkout query relies on. Use 6543.
#
# Where to find it:
#   Supabase Dashboard > Settings > Database > Connection string
#   Select "Transaction" mode, copy the URI, replace [YOUR-PASSWORD].
#
# Format:
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Add ?sslmode=require if your client does not default to SSL (ours does).
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres


# ------------------------------------------------------------------
# BSV FUNDING WALLET [REQUIRED] — server-only — MOST SENSITIVE
#
# WIF-encoded private key for the hot wallet that pays BSV tx fees.
# The corresponding address must be pre-funded with BSV before comments work.
#
# Generate a new key (MUST use fromRandom — never use `new PrivateKey()`):
#   node -e "const {PrivateKey}=require('@bsv/sdk'); console.log(PrivateKey.fromRandom().toWif())"
#
# Find the deposit address after setting this key:
#   GET /api/health  ->  wallet.address
#
# Recommended funding: enough for ~1000 UTXOs at 546 sats each (~0.00055 BSV).
# The UTXO replenishment cron (every 5 min) will auto-split the balance.
#
# In Vercel: set this as a Production-only variable, never preview/development.
# ------------------------------------------------------------------
BSV_FUNDING_KEY=your-wif-private-key-here


# ------------------------------------------------------------------
# UPSTASH REDIS [REQUIRED for rate limiting] — server-only
#
# Used for sliding-window rate limiting on POST /api/comments.
#
# FAIL-CLOSED policy: if Redis is unavailable or these vars are missing
# in PRODUCTION, all POST /api/comments requests are rejected with 503.
# In DEVELOPMENT, missing vars disable rate limiting (local convenience).
#
# Create a free Upstash Redis database at https://console.upstash.com
# Then copy the REST URL and token from the database detail page.
# ------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here


# ------------------------------------------------------------------
# CONTENT MODERATION [REQUIRED in production] — server-only
#
# Primary: OpenAI Moderation API (free endpoint, no extra billing beyond the key).
# Fallback: keyword-based filter (runs in development/test when no key is set).
#
# Fail-CLOSED policy: if the key is set and the OpenAI API is unreachable,
# the comment is REJECTED (503). In production, a missing key throws
# ModerationUnavailableError immediately — the keyword fallback does NOT run.
#
# Get a key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-...


# ------------------------------------------------------------------
# ADMIN API KEY [REQUIRED for admin routes] — server-only
#
# Protects all /api/admin/* endpoints (blocklist management, reconciliation).
# Use a long random string — generate one with: openssl rand -hex 32
#
# Pass as: Authorization: Bearer <ADMIN_API_KEY>
# ------------------------------------------------------------------
ADMIN_API_KEY=your-admin-api-key-here


# ------------------------------------------------------------------
# CRON SECRET [REQUIRED for cron routes] — server-only
#
# Protects /api/cron/* routes from unauthorized invocations.
# Vercel sends this automatically when invoking cron jobs.
# Must match the value configured in Vercel's environment variables.
#
# Generate: openssl rand -hex 32
# ------------------------------------------------------------------
CRON_SECRET=your-cron-secret-here


# ------------------------------------------------------------------
# MONITORING ALERTS [OPTIONAL] — server-only
#
# Slack or Discord incoming webhook URL.
# Used by /api/health and cron jobs to alert when:
#   - Free UTXO count drops below ALERT_UTXO_MIN_FREE (default: 3)
#   - Wallet balance drops below ALERT_WALLET_MIN_SATS (default: 10000)
#   - CSAM is detected (always alerts regardless of this setting)
#
# Slack:   https://api.slack.com/messaging/webhooks
# Discord: Server Settings > Integrations > Webhooks
# ------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Minimum free UTXOs before an alert fires (default: 3)
ALERT_UTXO_MIN_FREE=3

# Minimum wallet balance in satoshis before an alert fires (default: 10000)
ALERT_WALLET_MIN_SATS=10000


# ------------------------------------------------------------------
# ADMIN ALERT WEBHOOK [OPTIONAL] — server-only
#
# Separate webhook specifically for CSAM/legal detections.
# Can be the same URL as ALERT_WEBHOOK_URL or a more restricted channel.
# Receives a POST with a JSON payload on CSAM detection or admin blocklist add.
# ------------------------------------------------------------------
ADMIN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...


# ------------------------------------------------------------------
# NCMEC CYBERTIPLINE [REQUIRED before public launch] — server-only
#
# FEDERAL LEGAL OBLIGATION: Under 18 U.S.C. § 2258A, any Electronic
# Service Provider (ESP) that obtains actual knowledge of apparent CSAM
# on its platform MUST report it to the NCMEC CyberTipline. Failure to
# report is a federal crime. These credentials are NOT optional for any
# production deployment that accepts user-generated content.
#
# Register as an Electronic Service Provider (ESP) at:
#   https://www.missingkids.org/gethelpnow/cybertipline
#
# Until credentials are set, CSAM detections are logged and alerted
# but NO report is filed with NCMEC. This is legally insufficient in
# production. Do not launch publicly without completing ESP registration.
# ------------------------------------------------------------------
NCMEC_ESP_ID=
NCMEC_API_TOKEN=


# ------------------------------------------------------------------
# JUNGLEBUS INDEXER [OPTIONAL] — server-only
#
# BSV transaction indexer used for chain-to-DB reconciliation.
# Used by: POST /api/admin/reconcile and GET /api/cron/reconcile
#
# Setup steps:
#   1. Leave JUNGLEBUS_SUBSCRIPTION_ID blank on first deploy.
#   2. Call POST /api/admin/reconcile once — it will create the subscription
#      and log the ID. Alternatively run createSubscription() directly.
#   3. Copy the returned subscription ID into JUNGLEBUS_SUBSCRIPTION_ID.
#
# The reconciliation cron (every 15 min) is a no-op without a subscription ID.
# ------------------------------------------------------------------
JUNGLEBUS_URL=https://junglebus.gorillapool.io
JUNGLEBUS_API_KEY=
JUNGLEBUS_SUBSCRIPTION_ID=


# ------------------------------------------------------------------
# APP CONFIG OVERRIDES [OPTIONAL] — mixed visibility
# ------------------------------------------------------------------

# Max comment length in characters (default: 512)
# NEXT_PUBLIC_ — exposed to the browser for client-side validation
NEXT_PUBLIC_MAX_COMMENT_LENGTH=512

# Rate limit: max POST /api/comments requests per window per IP (default: 5)
RATE_LIMIT_MAX=5

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# Rate limit: max requests per hour per IP (default: 50)
RATE_LIMIT_HOURLY_MAX=50


# ------------------------------------------------------------------
# RATE LIMIT SALT [REQUIRED in production] — server-only
#
# A secret used when hashing IP addresses before storing them as Redis keys.
# Raw IPs are never written to Redis — only a 16-char SHA-256 hex digest is.
#
# Without this salt an attacker who gains read access to Redis cannot
# reverse the hashes back to real IP addresses.
#
# Generate a strong salt:
#   openssl rand -hex 32
#
# In development, a weak placeholder is used automatically so the app runs
# without this var.  Production deployments MUST set it.
# ------------------------------------------------------------------
RATE_LIMIT_SALT=your-random-32-byte-hex-salt-here


# ------------------------------------------------------------------
# GLOBAL RATE LIMITING [OPTIONAL] — server-only
#
# Ceiling on total comments accepted per hour across ALL IPs.
# Protects against coordinated distributed spam that stays under per-IP limits.
# Redis key: nothing_app:rl:global
# ------------------------------------------------------------------

# Max comments per hour globally (default: 500)
GLOBAL_RATE_LIMIT_MAX=500

# Window for the global rate limit in seconds (default: 3600)
GLOBAL_RATE_LIMIT_WINDOW=3600


# ------------------------------------------------------------------
# DAILY SPEND CAP [OPTIONAL] — server-only
#
# Maximum on-chain satoshis the app will spend in a single calendar day (UTC).
# When hit, POST /api/comments returns 503 until midnight UTC.
# Redis key: nothing_app:spend:daily:YYYY-MM-DD  (auto-expires after 25 h)
# ------------------------------------------------------------------

# Daily spend ceiling in satoshis (default: 50000)
DAILY_SPEND_CAP_SATS=50000


# ------------------------------------------------------------------
# CIRCUIT BREAKER [OPTIONAL] — server-only
#
# Tracks consecutive broadcast failures.  After CIRCUIT_BREAKER_THRESHOLD
# consecutive failures the breaker trips and all new comments are rejected
# for CIRCUIT_BREAKER_COOLDOWN_SECONDS seconds, preventing fee waste during
# an ARC/network outage.  The counter resets on any successful broadcast.
#
# Redis keys:
#   nothing_app:cb:failures  — consecutive failure counter
#   nothing_app:cb:open      — presence = breaker is open (has TTL)
# ------------------------------------------------------------------

# Consecutive failures before tripping (default: 10)
CIRCUIT_BREAKER_THRESHOLD=10

# Cooldown duration in seconds after tripping (default: 300 = 5 min)
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
